# 本地开发环境变量模板。
# 用法：cp .env.example .env，再按需改值。.env 已被 .gitignore 忽略，不要提交真实凭据。
#
# 加载规则：仅非 production 环境读取 .env，且不覆盖进程中已存在的变量。
# 生产部署请直接设置环境变量，不要依赖本文件。

# ---- HTTP 服务 ----

# HTTP 监听地址
LIM_TOOLS_ADDR=:8080

# 运行环境：development / staging / production
# 设为 production 会切 gin release 模式、日志升到 Info 级，并关闭 .env 加载
LIM_TOOLS_ENV=development

# 优雅关闭时等待在途请求的上限，如 10s、30s。零值或负值回落默认值 10s
LIM_TOOLS_SHUTDOWN_TIMEOUT=10s

# ---- PostgreSQL ----

LIM_TOOLS_DB_HOST=127.0.0.1
LIM_TOOLS_DB_PORT=5432
LIM_TOOLS_DB_NAME=limtools
LIM_TOOLS_DB_USER=limadmin

# 密码不要写进本文件后提交；.env 会被 gitignore，这里留空即可
LIM_TOOLS_DB_PASSWORD=

# libpq 风格的 SSL 模式：disable / allow / prefer / require / verify-ca / verify-full
# 本地开发用 disable，生产按数据库侧要求调整
LIM_TOOLS_DB_SSLMODE=disable
